{
    "name":  "buildflow",
    "version":  "0.1.0",
    "description":  "A local-first AI app builder for people who do not write code.",
    "private":  true,
    "license":  "Apache-2.0",
    "author":  "Buildflow contributors",
    "homepage":  "https://github.com/buildflow-labs/buildflow#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/buildflow-labs/buildflow.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/buildflow-labs/buildflow/issues"
             },
    "keywords":  [
                     "ai-app-builder",
                     "local-first",
                     "electron",
                     "codex",
                     "no-code",
                     "nextjs"
                 ],
    "engines":  {
                    "node":  "\u003e=24"
                },
    "type":  "module",
    "main":  "dist/main/index.js",
    "scripts":  {
                    "dev":  "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs --watch\" \"wait-on tcp:5173 file:dist/main/index.js file:dist/preload/index.cjs \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/run-electron.mjs\"",
                    "build":  "tsc -p tsconfig.main.json \u0026\u0026 esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs \u0026\u0026 vite build",
                    "start":  "node scripts/run-electron.mjs",
                    "test":  "vitest run --root . --exclude **/.e2e-data/** --testTimeout=20000 --hookTimeout=20000 --maxWorkers=1",
                    "typecheck":  "tsc --noEmit \u0026\u0026 tsc -p tsconfig.main.json --noEmit",
                    "package":  "npm run build \u0026\u0026 electron-builder",
                    "package:win":  "npm run build \u0026\u0026 electron-builder --win nsis --publish never"
                },
    "dependencies":  {
                         "@tailwindcss/vite":  "4.3.3",
                         "tailwindcss":  "4.3.3",
                         "zod":  "4.6.5",
                         "zustand":  "5.0.15"
                     },
    "devDependencies":  {
                            "@types/node":  "26.6.5",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "@vitejs/plugin-react":  "6.1.2",
                            "concurrently":  "10.0.6",
                            "cross-env":  "10.1.0",
                            "electron":  "44.9.2",
                            "electron-builder":  "26.18.0",
                            "esbuild":  "0.28.2",
                            "react":  "19.3.1",
                            "react-dom":  "19.3.1",
                            "typescript":  "7.0.2",
                            "vite":  "8.3.4",
                            "vitest":  "5.0.5",
                            "wait-on":  "9.5.1"
                        },
    "build":  {
                  "appId":  "com.buildflow.desktop",
                  "productName":  "Buildflow",
                  "asar":  true,
                  "directories":  {
                                      "output":  "release"
                                  },
                  "win":  {
                              "target":  "nsis",
                              "icon":  "assets/buildflow.ico"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true
                           },
                  "files":  [
                                "dist/**/*",
                                "assets/buildflow.png",
                                "package.json"
                            ]
              }
}
